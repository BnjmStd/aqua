# Clave para firmar los JWT de autenticacion de Payload.
# Si la cambias, todas las sesiones abiertas se invalidan.
PAYLOAD_SECRET=cambiar-por-una-clave-aleatoria-de-32-bytes

# Base de datos. Hoy: archivo SQLite local (no requiere Docker ni servidor).
# Al migrar a Postgres, aca va la connection string:
#   DATABASE_URI=postgres://usuario:pass@host:5432/aquabioprocess
DATABASE_URI=file:./aquabioprocess.db

# URL publica del sitio. Se usa en los enlaces de los correos y en las
# listas blancas de CORS y CSRF.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
