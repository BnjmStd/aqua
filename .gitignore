# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# staging local de extraccion de PDFs (texto/imagenes); no se versiona
utils/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# payload
# archivos privados del aula (collections/academy/Recursos.ts): nunca se versionan
/recursos/
# respaldos de justificaciones (certificados medicos, etc.): datos personales, nunca al repo
/justificaciones/
/media/*
# ...salvo las imagenes de la semilla (se suben en scripts/seed.ts y las
# referencia aquabioprocess.seed.db, asi el sitio renderiza en un clon nuevo)
!/media/fundador.jpg
!/media/fundador-*.jpg
!/media/hero-planta.jpg
!/media/hero-planta-*.jpg
!/media/hero-consulting.jpg
!/media/hero-consulting-*.jpg
!/media/hero-academy.jpg
!/media/hero-academy-*.jpg
!/media/logo.png
!/media/logo-*.png
!/media/bioindicador-*.jpg
!/media/corrosion-*.jpg
!/media/newsletter-*.jpg
!/media/auditoria-*.jpg
!/media/cambios-ref-*.jpg
*.db
*.db-shm
*.db-wal
# ...salvo la semilla de desarrollo, que si se versiona (ver scripts/db-seed.ts)
!aquabioprocess.seed.db
!.env.example
